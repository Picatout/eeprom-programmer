object FormMain: TFormMain
  Left = 600
  Height = 904
  Top = 0
  Width = 1075
  Anchors = []
  BorderStyle = bsSingle
  Caption = 'eeProg'
  ClientHeight = 904
  ClientWidth = 1075
  DesignTimePPI = 120
  Menu = mItemFiles
  OnActivate = FormActivate
  OnClose = FormClose
  OnCreate = FormCreate
  OnShow = FormShow
  LCLVersion = '3.8.0.0'
  object MemoConsole: TMemo
    Left = 0
    Height = 864
    Top = 40
    Width = 1075
    Align = alBottom
    Font.CharSet = ANSI_CHARSET
    Font.Height = -20
    Font.Name = 'Courier New'
    Font.Pitch = fpFixed
    Font.Quality = fqDraft
    ParentFont = False
    ReadOnly = True
    ScrollBars = ssVertical
    TabOrder = 0
    OnChange = MemoConsoleChange
  end
  object Label1: TLabel
    Left = 0
    Height = 40
    Top = 0
    Width = 85
    Align = alLeft
    Caption = 'command'
    Font.CharSet = ANSI_CHARSET
    Font.Height = -20
    Font.Name = 'Sans'
    Font.Pitch = fpVariable
    Font.Quality = fqDraft
    ParentFont = False
  end
  object EditCmd: TEdit
    Left = 110
    Height = 40
    Top = 0
    Width = 965
    Align = alRight
    Anchors = [akTop, akRight]
    Font.Height = -20
    Font.Name = 'Sans'
    ParentFont = False
    TabOrder = 1
    OnChange = EditCmdChange
    OnExit = EditCmdExit
    OnKeyPress = EditCmdKeyPress
  end
  object mItemFiles: TMainMenu
    Left = 10
    Top = 80
    object MenuItem1: TMenuItem
      Caption = '&Files'
      object mItemView: TMenuItem
        Caption = '&View range'
        Hint = 'view eeprom range'
        OnClick = mItemViewClick
      end
      object mItemErase: TMenuItem
        Caption = '&Erase range'
        Hint = 'erase EEPROM range'
        OnClick = mItemEraseClick
      end
      object MtemEraseAll: TMenuItem
        Caption = 'Erase &All'
        OnClick = MtemEraseAllClick
      end
      object MItemProg: TMenuItem
        Caption = '&Program EEPROM'
        Hint = 'program EEPROM from file'
        OnClick = MItemProgClick
      end
      object mItemDump: TMenuItem
        Caption = '&Dump range'
        Hint = 'Dump eeprom range to file'
        OnClick = mItemDumpClick
      end
      object mItemReboot: TMenuItem
        Caption = '&Reboot'
        OnClick = mItemRebootClick
      end
      object Separator1: TMenuItem
        Caption = '-'
      end
      object MItemQuit: TMenuItem
        Caption = '&Quit'
        Hint = 'Leave eeProg IDE'
        OnClick = MItemQuitClick
      end
    end
    object mItemConfig: TMenuItem
      Caption = '&Config'
      object MItemPortCfg: TMenuItem
        Caption = '&Port'
        Hint = 'configure serial port'
        OnClick = MItemPortCfgClick
      end
      object mItemEeprom: TMenuItem
        Caption = 'eeprom'
        OnClick = mItemEepromClick
      end
    end
    object mItemAbout: TMenuItem
      Caption = 'About'
      OnClick = mItemAboutClick
    end
  end
  object OpenDialog: TOpenDialog
    Title = 'Ouvrir un fichier'
    FilterIndex = -1
    InitialDir = '.'
